<?xml version="1.0"?>
<!--
  抓取流程 3：反向对角搬运场景。
  机械臂由 launch 文件动态生成；目标物初始位姿必须与 grasp3.yaml 的 A3 点一致。
-->
<sdf version="1.8">
  <world name="grasp_world3">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 桌子：实心方块，桌面高 0.75m -->
    <model name="table">
      <static>true</static>
      <pose>0.1 0 0.375 0 0 0</pose>
      <link name="table_link">
        <collision name="c"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.7 0.75</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 目标物：25mm、50g 方块，初始位姿 = grasp3.yaml 的 A3 点。 -->
    <model name="target_object">
      <pose>0.075 -0.115 0.7635 0 0 0</pose>
      <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="body">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>5.2e-6</ixx><iyy>5.2e-6</iyy><izz>5.2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0.15 0.35 0.9 1</ambient><diffuse>0.15 0.35 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>